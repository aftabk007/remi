# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Local copy of cron migration contains hardcoded service key.
# Use 0002_cron.sql.example as the committed template.
/supabase/migrations/0002_cron.sql

# Supabase CLI machine-local state
/supabase/.temp
/supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts
